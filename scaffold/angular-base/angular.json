{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false,
    "cache": {
      "enabled": true,
      "path": "../.angular-cache"
    }
  },
  "newProjectRoot": "projects",
  "projects": {
    "angular-base": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "src/styles.css"
            ],
            "outputPath": {
              "base": "dist/app",
              "browser": ""
            }
          },
          "configurations": {
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "production": {
              "outputHashing": "all"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
