# Copie para .env e preencha. O .env NUNCA e versionado.

# Gemini: uma chave, ou varias (GEMINI_API_KEY_1 .. _9). Limite por minuto: rotaciona; cota diaria
# esgotada: a chave sai da rotacao e a execucao segue com a proxima.
GEMINI_API_KEY=
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=

# Figma: so para `python scripts/fetch_figma.py` (UMA chamada; plano Starter ~6 chamadas/mes)
FIGMA_TOKEN=
FIGMA_FILE_KEY=

# Opcional: diretorio de cache dos modelos de embedding (DINOv2, CLIP)
# HF_HOME=C:/specui-models
