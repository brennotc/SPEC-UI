# Segredos (NUNCA subir para o GitHub)
.env

# Ambientes virtuais Python
venv/
.venv/
env/

# Cache do Python, testes e linters
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
*.egg-info/

# Resultados gerados pela execução: results/ fica INTEIRO fora do git (sem negações).
# Para depositar resultados use `specui export` (opcional).
results/

# Dados privados da coleta de prompts livres (export bruto do formulario, antes da remocao de PII)
private/

# Scaffold Angular: dependencias, caches de build e saidas (o lockfile e commitado)
scaffold/**/node_modules/
scaffold/**/dist/
scaffold/**/.angular/
.angular-cache/

# Configuracao local do Claude Code
.claude/settings.local.json

# VS Code / IDEs
.vscode/
.idea/
